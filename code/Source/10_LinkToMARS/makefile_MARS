MYNAME = LinkcupidMARS
MYNAME1 = s_LinkcupidMARS
VER = 01
EXCNAME = $(MYNAME).x
LIBNAME = lib$(MYNAME).a
SRCNAME = $(MYNAME).for
BACKUPNAME = $(MYNAME1)_$(VER).tar

FFLAGS = -DMCC $(FOPTFLAGS) -I$(INCDIR1) -I$(INCDIR2) -module ../Modules -I$(INCDIR3)
CFLAGS = 
#----------------------------------------------------------------------
