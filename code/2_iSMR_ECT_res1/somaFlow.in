 &boundary_condition
                  nvin=               0
          vin_norm( 1)=               0
          vb_liq( 1,:)=     -0.594000     0.000000     0.00000
          vb_gas( 1,:)=     -0.594000     0.000000     0.00000
        alphab_gas( 1)=        0.000000
            qualab( 1)=        0.000000
           cboronb( 1)=        0.000000
