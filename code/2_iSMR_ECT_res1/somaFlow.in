        t_end_ctrl( 1)=        20000.000d-3
     toutstep_ctrl( 1)=        10.0000d0
    treststep_ctrl( 1)=        0.100000d+10
cfl_ratio_max_ctrl( 1)=        0.500000d0
         smac_ctrl( 1)=               3
       dt_opt_ctrl( 1)=               0
       dt_max_ctrl( 1)=    0.100000D-00

        t_end_ctrl( 2)=        10000.000
     toutstep_ctrl( 2)=        10.00000
    treststep_ctrl( 2)=        0.100000D+10
cfl_ratio_max_ctrl( 2)=        0.300000
