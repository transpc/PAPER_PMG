          max_iter_mom=             100
        max_iter_alpha=             100
       max_iter_scalar=             100
           max_iter_ke=             100
           max_iter_dp=             100
       max_iter_boron=            100
          max_iter_rad=             100
 /


 &second_order
         mass_conv_2nd=               0
          mom_conv_2nd=               0
          eng_conv_2nd=               0
         qula_conv_2nd=               0
          ncg_conv_2nd=               0
        boron_conv_2nd=               0
         turb_conv_2nd=               0

          limiter_mass=               0
           limiter_mom=               0
           limiter_eng=               0
            limiter_xn=               0
            limiter_qn=               0
         limiter_boron=               0
          limiter_turb=               0

                faclim=        1.000000
                   vkt=        0.000000
 /


 &turb
                 iturb=               2
            turb_phase=               3
           lowreynolds=               0
         buoyancy_turb=               1
                tlengs=        0.000000
             turbubble=               0
               turboil=               0
		i_macroturb_source=           	  0     !macroscopic turbulece model (0=none, 1=chandesris, 2=nakayama)
           i_turb_zero=         	    1     !zero equation model (0=none, 1=constant, 2=telluride, 3=cfx, 4=vanDriest, 5=Baldwin_Lomax, 6=noto, 7=user)
           i_wall_fric=               0     !wall friction model (0=none, 1=kakac, 2=darcy, 3=udf)   
 /


 &int_ht
                mtopol=               2
                  mHTC=               2
          H_il_coeff_a=    0.000000D+00
          H_il_coeff_b=    0.100000D+09
              H_il_min=      100.000000
          H_ig_coeff_a=    0.000000D+00
          H_ig_coeff_b=    0.100000D+08
              H_ig_min=      100.000000
          H_fg_coeff_a=    0.000000D+00
          H_fg_coeff_b=    0.100000D+09
              H_fg_min=      100.000000
                   dtl=        3.000000
                   dtg=        3.000000
         H_il_min_user=    0.100000D+08
         H_il_min_ag99=    0.100000D+07
             relax_hik=        0.000000
            l_th_equil=               1
             l_min_hik=               1
            alphag_min=    0.100000D-03
            alphal_min=    0.100000D-03
              i_weight=               0     !modifying weighting value for drag force when mdrag>=1
 /


 &int_mom
                 mdrag=               1
                  Ntdf=        0.400000
                 Nlift=        0.000000
                  Nwlf=        0.000000
          Drag_coeff_a=    0.120000D+05
          Drag_coeff_b=    0.000000D+00
            vFgl_1_min=        1.000000
            vFgl_2_min=        1.000000
            vFgl_3_min=      100.000000

           Cd_min_user=        1.000000
           Cd_min_ag99=        0.100000
              relax_cd=        0.990000
           i_turb_disp=           		0      !turbulent dispersion force model (0=none, 1=cfx, 2=gosman, 3=burns, 4=udf)
            i_wall_lub=          			1      !wall lubrication force model     (0=none, 1=antal&cfx, 2=antal&antal, 3=tomiyama, 4=udf)      
 /


 &iat_heatpart
                   iat=              -1
          dbubble_init=        0.004000
             iheatpart=               4
               kfactor=        4.000000
               wconden=               0
     rv_htmodel_forCFD=               0      !use RV-wall heat transfer model package for fluid-solid interface without RV heat structures
           dia_rod_cfd=             0.0      !rod or pipe diameter for condensation HTC model (IF rv option is ON, dia_rod in rv_parameter will overwrite this.)               
             rad_model=               0
             abs_coeff=             1.0
            wall_emiss=             1.0
            
     i_bubble_diameter=               5      !bubble diameter model (0=none, 1=yoneda, 2=trac, 3=modified_yoneda, 4=viswanathan, 5=hibiki, 6=yun)
           r_dh_hibiki=     7.839514d-3      !hd for Hibiki model
              r_db_min=          0.0001               
              r_db_max=        0.008319                 
       i_drop_diameter=               1      !droplet diameter model (0=none, 1=constant)
               r_ddrop=           0.001        
 /


 &ncg
              n_ncg_sp=               1
              ncg_diff=               0
               imp_ncg=               0
             i_ncg_vis=               0      !exact viscosity when ncg-gas exists. (0=OFF, 1=ON but slow) 
       ncg_species( 1)=               6
          qn_cell0( 1)=        1.000000
         qn_nvin(1, 1)=        1.000000
         qn_npin(1, 1)=        1.000000
      
 /


