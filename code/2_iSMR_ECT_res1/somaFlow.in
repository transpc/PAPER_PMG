          t_liq_nd( 2)=      300.000000
          t_gas_nd( 2)=      300.000000
      alpha_gas_nd( 2)=      100.000000
          quala_nd( 2)=        1.000000

          i_horizontal_outlet=        0

          n_constTwall=               0

          n_constqwall=               0
       qwall_solid( 1)=  1438377.760000
 /


 &n_scheme
              parallel=               1
                psolve=               4
                 metis=               1
              eps_bicg=    0.100000D-07
              max_bicg=            1000
              min_bicg=              15
              iavgtype=               0
              irc_damp=               1
