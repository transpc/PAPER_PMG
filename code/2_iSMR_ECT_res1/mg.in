 &MG_tuning
 teta       = 0.6          ! coarsening threshold
 teta_p     = 0.65         ! interpolation neighbor threshold
 alpha      = 0.005        ! P-matrix drop tolerance
 itergs(1)  = 1            ! smoothing sweeps per level; unset levels inherit previous
 itergs(2)  = 1
 itergs(3)  = 2
 icheb(1)   = 2            ! Chebyshev iterations (2~4)
 ip_nmax    = 4            ! max neighbor cells for interpolation
 ip_inter   = 1            ! (1) distance-based; (2) linear function
 ip_lev     = 1            ! connectivity levels for neighbor search
 /
 &MG_options
 il1_gs     = 0            ! (1) l1-corrected coarse GS (partition-robust)
 nthre      = 1            ! OpenMP threads
 /
